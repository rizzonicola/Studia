# Cloudflare Pages - regole degli header (formato: percorso, poi header indentati di due spazi).
# Le regole che corrispondono a piu' percorsi vengono sommate.
# Documentazione: https://developers.cloudflare.com/pages/configuration/headers/
#
# Note sulla Content-Security-Policy:
#  - script-src 'self': nessuno script inline e nessun CDN (un XSS non puo' eseguire codice iniettato).
#  - style-src 'unsafe-inline': necessario per gli stili in linea di KaTeX, vis-network e per gli attributi style di React.
#    Rischio basso (solo stili, nessun codice).
#  - connect-src: solo Google Gemini (SDK e File API).
#  - HSTS senza "preload" di proposito: l'iscrizione alla preload list e' quasi irreversibile; aggiungila solo se vuoi.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' https://generativelanguage.googleapis.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Schermate private/operative dell'app (SPA): mai nell'indice di Google. Si usa l'header e NON "Disallow" in robots.txt, perche' un
# crawler bloccato da robots.txt non leggerebbe mai il noindex. Le pagine pubbliche (/, /terms, /privacy, /it/, /en/, /fr/) non sono qui.
/note/*
  X-Robots-Tag: noindex, nofollow
/folder/*
  X-Robots-Tag: noindex, nofollow
/settings
  X-Robots-Tag: noindex, nofollow
/upload
  X-Robots-Tag: noindex, nofollow
/camera
  X-Robots-Tag: noindex, nofollow

# Avvisi di terze parti generati dalla build (licenze dei pacchetti): testo semplice, sempre rivalidato
/THIRD-PARTY-NOTICES.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

# File con hash nel nome generati da Vite: immutabili
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sempre rivalidati: un nuovo deploy e' visibile subito
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
/theme-init.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/manifests/*
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Icone e immagine social: nomi stabili, cache di 7 giorni
/icons/*
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
